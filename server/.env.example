# Copy to .env and fill in real values. Never commit .env.
NODE_ENV=development
PORT=5000

# MongoDB connection string (local or MongoDB Atlas).
# Leave empty to run the API without a database (only /api/health works).
MONGODB_URI=mongodb://127.0.0.1:27017/parkly

# Secret used to sign login tokens. Use a long random string in production, e.g.:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# Cloudinary (listing photos). Find these on your Cloudinary dashboard.
# Leave empty to run without photo uploads (the API returns a clear 503 for uploads).
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Frontend origin(s) allowed by CORS, comma-separated.
CLIENT_URL=http://localhost:5173
